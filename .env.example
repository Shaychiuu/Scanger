
# Docker Compose interpolates .env values.

# Existing baseline settings (API_URL is read by the upstream VisualMatch frontend)
API_URL=http://127.0.0.1:8001
VISUALMATCH_MODEL=siglip_vitb16
# Experiment: FashionCLIP (patrickjohncyh/fashion-clip). Needs its index first:
#   python -m scanger.build_fashionclip_index
# VISUALMATCH_MODEL=fashionclip
# FASHIONCLIP_DEVICE=cpu   # optional; default is cuda, then mps, then cpu

# Scanger: the frontend calls the Scanger API, which calls the VisualMatch API.
# Defaults shown; only set these if you change ports.
# SCANGER_API_URL=http://127.0.0.1:8010
# VISUALMATCH_API_URL=http://127.0.0.1:8001

# PostgreSQL (Docker Compose service "db")
DB_NAME=scanger
DB_USER=scanger
DB_PW=change-me # Avoid "$" and spaces 
DB_HOST=127.0.0.1
DB_PORT=5433

# App-owned files (uploads). Relative paths resolve against the repository root.
DATA_ROOT=./user-data

# M03 (optional): hosted image interpretation via the Cursor SDK.
# The image and text are sent to Cursor for inference. Key: Cursor Dashboard -> API Keys.
# Find model ids and parameters with: python -m scanger.interpret --list-models
# CURSOR_API_KEY=
# INTERPRET_MODEL=
# INTERPRET_MODEL_PARAMS=   # comma-separated id=value pairs from the catalog

# M04 (optional): web discovery via SerpApi (https://serpapi.com/manage-api-key).
# Queries and locale settings are sent to SerpApi, which runs them on Google.
# Every successful, uncached search uses one search from the plan (free: 250/month, 50/hour).
# SERPAPI_API_KEY=
# DISCOVERY_CONFIG=discovery.toml   # query plan, languages, modifiers; path relative to the repo root

# Optional upload limits (defaults shown)
# MAX_UPLOAD_BYTES=10485760
# MAX_IMAGE_DIMENSION=4096
